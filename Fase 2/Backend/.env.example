# ============================================================
# .env.example  (plantilla, se copia a ".env")
# ============================================================
#   cp .env.example .env    (o copia y pega en Windows)
# .env esta en .gitignore: NO subirlo.
#
# Los valores de abajo YA SON los de Supabase local: salen de
# "npx supabase status" (corrido desde esta carpeta, Backend/), en la
# linea "DB URL":
#   postgresql://postgres:postgres@127.0.0.1:55322/postgres
#
# Lo leen DOS cosas:
#   - La API (dotenv, en src/db.js) cuando corre SIN Docker.
#   - Docker Compose, para PGPORT / PGUSER / PGPASSWORD / PGDATABASE.
#     PGHOST lo fija el compose (host.docker.internal) y pisa el de
#     este archivo dentro del contenedor.

# Puerto de la API.
PORT=3000

# ------------------------------------------------------------
# BASE DE DATOS (Supabase local)
# ------------------------------------------------------------
PGHOST=localhost
PGPORT=55322
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=postgres

# ------------------------------------------------------------
# SESIÓN (JWT) — OBLIGATORIO
# ------------------------------------------------------------
# Firma los tokens de sesión. Sin él (o con menos de 32 caracteres)
# la API NO arranca. Cada máquina/entorno genera el suyo con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Cambiarlo cierra todas las sesiones abiertas.
JWT_SECRET=reemplaza-con-el-resultado-del-comando-de-arriba

# "true" solo al publicar detrás de HTTPS: la cookie de sesión viaja
# solo por HTTPS. En local (http) dejarlo vacío o en false.
COOKIE_SECURE=false

# ------------------------------------------------------------
# SOLO DOCKER (opcional)
# ------------------------------------------------------------
# Host de la base visto desde DENTRO del contenedor de la API.
# Si se borra, el compose usa host.docker.internal (Supabase local).
# PGHOST_DOCKER=host.docker.internal
